            "state" : "translated",
            "value" : "Nuevo animal"
          }
        }
      }
    },
    "learn_animal_reward_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You unlocked a friend"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueaste un amigo"
          }
        }
      }
    },
    "learn_animal_reward_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish every lesson in a section to unlock a new animal in your world."
          }
